#!/bin/bash
# Pre-commit hook - Runs before each commit
# Ensures code quality before committing

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

echo "🔍 Running pre-commit checks..."

# Get list of staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null || echo "")

if [ -z "$STAGED_FILES" ]; then
    echo "No staged files to check."
    exit 0
fi

EXIT_CODE=0

# Check 1: Run security scan on staged files
echo "📋 Checking for secrets in staged files..."
if command -v gitleaks &> /dev/null; then
    if ! gitleaks detect --source . --staged --report-path /tmp/gitleaks_staged.json 2>/dev/null; then
        echo "❌ Secrets detected in staged files!"
        cat /tmp/gitleaks_staged.json | jq '.[] | {File: .File, Secret: .Secret}' 2>/dev/null || true
        EXIT_CODE=1
    else
        echo "✅ No secrets detected"
    fi
else
    echo "⚠️  gitleaks not installed, skipping secret detection"
fi

# Check 2: Run complexity analysis on changed Python files
echo "📊 Checking code complexity..."
PY_FILES=$(echo "$STAGED_FILES" | grep '\.py$' || echo "")
if [ -n "$PY_FILES" ] && command -v python3 &> /dev/null; then
    for file in $PY_FILES; do
        if [ -f "$file" ]; then
            RESULT=$(python3 "$PROJECT_ROOT/scripts/testing/complexity_analyzer.py" --root "$PROJECT_ROOT" --output /tmp/complexity_check.json 2>&1 || echo "FAILED")
            if echo "$RESULT" | grep -q "FAILED"; then
                echo "❌ Complexity violations in $file"
                EXIT_CODE=1
            fi
        fi
    done
    if [ $EXIT_CODE -eq 0 ]; then
        echo "✅ Code complexity OK"
    fi
fi

# Check 3: Run formatters
echo "🎨 Formatting code..."

# Python: black + isort
if command -v black &> /dev/null; then
    PY_FILES_TO_FORMAT=$(echo "$STAGED_FILES" | grep '\.py$' || echo "")
    if [ -n "$PY_FILES_TO_FORMAT" ]; then
        black --quiet $PY_FILES_TO_FORMAT 2>/dev/null || true
        isort --quiet $PY_FILES_TO_FORMAT 2>/dev/null || true
        echo "✅ Python files formatted"
    fi
fi

# JS/TS: prettier
if command -v prettier &> /dev/null; then
    JS_FILES=$(echo "$STAGED_FILES" | grep -E '\.(js|ts|jsx|tsx)$' || echo "")
    if [ -n "$JS_FILES" ]; then
        prettier --write $JS_FILES --log-level silent 2>/dev/null || true
        echo "✅ JS/TS files formatted"
    fi
fi

# Check 4: Validate requirements format
echo "📝 Validating requirements format..."
REQ_FILES=$(echo "$STAGED_FILES" | grep '^requirements/REQ_.*\.md$' || echo "")
if [ -n "$REQ_FILES" ] && [ -f "$PROJECT_ROOT/scripts/common/validate_requirements.sh" ]; then
    for req_file in $REQ_FILES; do
        if [ -f "$req_file" ]; then
            if ! bash "$PROJECT_ROOT/scripts/common/validate_requirements.sh" "$req_file"; then
                echo "❌ Requirements format invalid: $req_file"
                EXIT_CODE=1
            fi
        fi
    done
    if [ $EXIT_CODE -eq 0 ] && [ -n "$REQ_FILES" ]; then
        echo "✅ Requirements format OK"
    fi
fi

# Check 5: Ensure tests exist for new code
echo "🧪 Checking test coverage for new code..."
NEW_SRC_FILES=$(echo "$STAGED_FILES" | grep '^src/.*\.\(py\|js\|ts\|rs\|go\|cs\)$' || echo "")
if [ -n "$NEW_SRC_FILES" ]; then
    for src_file in $NEW_SRC_FILES; do
        # Skip infrastructure and utility files
        if echo "$src_file" | grep -qE '(infrastructure|utils|config)'; then
            continue
        fi
        
        # Check if corresponding test file exists
        TEST_FILE=""
        if echo "$src_file" | grep -q '\.py$'; then
            TEST_FILE=$(echo "$src_file" | sed 's|^src/|tests/unit/|; s/\.py$/_test.py/')
        elif echo "$src_file" | grep -q '\.rs$'; then
            TEST_FILE="$src_file"  # Rust inline tests
        elif echo "$src_file" | grep -q '\.go$'; then
            TEST_FILE=$(echo "$src_file" | sed 's|\.go$|_test.go|')
        fi
        
        if [ -n "$TEST_FILE" ] && [ ! -f "$TEST_FILE" ]; then
            echo "⚠️  No test file found for $src_file (expected: $TEST_FILE)"
            # Warning only, don't block commit
        fi
    done
    echo "✅ Test coverage check completed"
fi

echo ""
if [ $EXIT_CODE -eq 0 ]; then
    echo "✅ All pre-commit checks passed!"
    exit 0
else
    echo "❌ Pre-commit checks failed. Please fix the issues above."
    echo "Hint: You can bypass with 'git commit --no-verify' (not recommended)"
    exit 1
fi
